<Window x:Class="DeskBridge.App.Views.PermissionDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="DeskBridge permission" Width="520" SizeToContent="Height" MaxHeight="640" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
  <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="Permission required" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="DeskBridge will only continue if you allow this action." Foreground="{StaticResource MutedBrush}" Margin="0,6,0,20"/></StackPanel>
    <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="18"><StackPanel><TextBlock Text="{Binding Action}" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="{Binding Target}" Margin="0,8,0,0" TextWrapping="Wrap" FontFamily="Cascadia Mono, Consolas"/><ItemsControl ItemsSource="{Binding Items}" Margin="0,10,0,0"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Margin="0,2" TextWrapping="Wrap"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
    <TextBlock Grid.Row="2" Margin="0,16" Foreground="{StaticResource MutedBrush}" Text="Allow once applies only to this request. Change per-action policy in Settings." TextWrapping="Wrap"/>
    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancel" Width="100" IsCancel="True" Margin="0,0,8,0"/><Button Content="Allow once" Width="120" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Allow_Click"/></StackPanel>
  </Grid>
</Window>
