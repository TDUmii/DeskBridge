<Window x:Class="DeskBridge.App.Views.PermissionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeskBridge permission" Icon="../Assets/app-icon.ico"
        Width="540" SizeToContent="Height" MaxHeight="660"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <Grid Margin="28">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <Border Width="40" Height="40" CornerRadius="10" ClipToBounds="True"><Image Source="../Assets/app-icon.png" Stretch="UniformToFill"/></Border>
                <StackPanel Margin="12,0,0,0"><TextBlock Text="Permission required" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="Review the exact action before DeskBridge continues." Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0"/></StackPanel>
            </StackPanel>
        </StackPanel>
        <Border Grid.Row="1" Style="{StaticResource PanelCard}" Margin="0,20,0,0" Background="{DynamicResource PanelRaisedBrush}">
            <StackPanel><TextBlock Text="{Binding Action}" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="{Binding Target}" Margin="0,8,0,0" TextWrapping="Wrap" FontFamily="Cascadia Mono, Consolas"/><ItemsControl ItemsSource="{Binding Items}" Margin="0,10,0,0"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Margin="0,2" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
        </Border>
        <TextBlock Grid.Row="2" Margin="0,16" Foreground="{DynamicResource MutedBrush}" Text="Allow once applies only to this request. Change the per-action policy in Settings." TextWrapping="Wrap"/>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancel" Width="100" IsCancel="True" Margin="0,0,8,0"/><Button Content="Allow once" Width="120" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Allow_Click"/></StackPanel>
    </Grid>
</Window>
