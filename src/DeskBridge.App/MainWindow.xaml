<Window x:Class="DeskBridge.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeskBridge" Width="1100" Height="760" MinWidth="860" MinHeight="600"
        WindowStartupLocation="CenterScreen">
    <Grid Background="{DynamicResource CanvasBrush}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Background="{DynamicResource HeaderBrush}" Padding="28,20">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="DeskBridge" Foreground="{DynamicResource HeaderInkBrush}" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="A deliberate local bridge for ChatGPT Web" Foreground="{DynamicResource HeaderMutedBrush}" Margin="0,4,0,0"/></StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Ellipse Width="10" Height="10" Fill="{DynamicResource SuccessBrush}" Margin="0,0,8,0"/><TextBlock Text="Control panel ready" Foreground="{DynamicResource HeaderInkBrush}" FontWeight="SemiBold"/></StackPanel>
            </Grid>
        </Border>
        <TabControl Grid.Row="1" Margin="24,20,24,12" BorderThickness="0">
            <TabItem Header="Workspace">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="6,22"><TextBlock Text="Current workspace" FontSize="13" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="{Binding Workspace}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,5,0,14"/><StackPanel Orientation="Horizontal"><Button Content="Choose workspace" Style="{StaticResource PrimaryButton}" Click="ChooseWorkspace_Click"/><Button Content="Open folder" Margin="8,0,0,0" IsEnabled="{Binding HasWorkspace}" Click="OpenWorkspace_Click"/></StackPanel><Separator Margin="0,28,0,22"/><TextBlock Text="How actions run" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="ChatGPT action blocks never run automatically. The native host validates the action, permission, workspace boundary, and action-specific arguments before execution." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" MaxWidth="720" HorizontalAlignment="Left" Margin="0,8,0,0"/></StackPanel></ScrollViewer>
            </TabItem>
            <TabItem Header="Activity">
                <Grid Margin="6,18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,12"><TextBlock Text="Recent activity" FontSize="20" FontWeight="SemiBold" DockPanel.Dock="Left"/><Button Content="Refresh" HorizontalAlignment="Right" Click="Refresh_Click"/></DockPanel><ListView Grid.Row="1" ItemsSource="{Binding Activities}" BorderBrush="{DynamicResource LineBrush}"><ListView.View><GridView><GridViewColumn Header="Time" Width="170" DisplayMemberBinding="{Binding Timestamp}"/><GridViewColumn Header="Action" Width="160" DisplayMemberBinding="{Binding Action}"/><GridViewColumn Header="Target" Width="430" DisplayMemberBinding="{Binding Target}"/><GridViewColumn Header="Result" Width="130" DisplayMemberBinding="{Binding Result}"/><GridViewColumn Header="ms" Width="70" DisplayMemberBinding="{Binding DurationMs}"/></GridView></ListView.View></ListView></Grid>
            </TabItem>
            <TabItem Header="Assets">
                <Grid Margin="6,18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Margin="0,0,0,12"><TextBlock Text="Workspace assets" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Images found below folders named assets. DeskBridge does not edit them here." Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0"/></StackPanel><ListView Grid.Row="1" ItemsSource="{Binding Assets}" BorderBrush="{DynamicResource LineBrush}"><ListView.View><GridView><GridViewColumn Header="File" Width="250" DisplayMemberBinding="{Binding Name}"/><GridViewColumn Header="Dimensions" Width="150" DisplayMemberBinding="{Binding Dimensions}"/><GridViewColumn Header="Size" Width="100" DisplayMemberBinding="{Binding Size}"/><GridViewColumn Header="Path" Width="500" DisplayMemberBinding="{Binding Path}"/></GridView></ListView.View></ListView></Grid>
            </TabItem>
            <TabItem Header="Settings">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="6,20" MaxWidth="860" HorizontalAlignment="Left">
                        <TextBlock Text="Appearance" FontSize="20" FontWeight="SemiBold"/>
                        <TextBlock Text="Follow Windows automatically or keep a fixed light or dark appearance." Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,12"/>
                        <Grid Margin="0,0,0,26"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Color theme" FontWeight="SemiBold" VerticalAlignment="Center"/><ComboBox Grid.Column="1" ItemsSource="{Binding ThemeModes}" SelectedItem="{Binding SelectedTheme, Mode=TwoWay}" SelectionChanged="Theme_SelectionChanged" AutomationProperties.Name="Color theme"/></Grid>

                        <TextBlock Text="Skill integrations" FontSize="20" FontWeight="SemiBold"/>
                        <TextBlock Text="Executable adapters perform a bounded local action. Guidance profiles provide instructions for ChatGPT; they do not run a local AI model." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,10"/>
                        <ItemsControl ItemsSource="{Binding SkillIntegrations}">
                            <ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,24,0"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><Border Background="{DynamicResource ControlHoverBrush}" CornerRadius="10" Padding="8,2" Margin="9,0,0,0"><TextBlock Text="{Binding Kind}" Foreground="{DynamicResource MutedBrush}" FontSize="11"/></Border></StackPanel><TextBlock Text="{Binding Description}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,0"/><Button Content="Copy instruction" HorizontalAlignment="Left" Margin="0,9,0,0" Padding="10,5" MinHeight="30" Click="CopySkillInstruction_Click"/></StackPanel><CheckBox Grid.Column="1" Content="Enabled" IsChecked="{Binding Enabled, Mode=TwoWay}" Checked="Skill_CheckedChanged" Unchecked="Skill_CheckedChanged" AutomationProperties.Name="{Binding Name}"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Separator Margin="0,26,0,22"/>
                        <TextBlock Text="Permissions" FontSize="20" FontWeight="SemiBold"/>
                        <TextBlock Text="Ask is recommended for actions with side effects. There is no allow-everything setting." Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,15"/>
                        <ItemsControl ItemsSource="{Binding Permissions}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Label}" FontWeight="SemiBold"/><TextBlock Text="{Binding Description}" Foreground="{DynamicResource MutedBrush}" Margin="0,3,20,0" TextWrapping="Wrap"/></StackPanel><ComboBox Grid.Column="1" ItemsSource="{Binding DataContext.Policies, RelativeSource={RelativeSource AncestorType=Window}}" SelectedItem="{Binding Policy, Mode=TwoWay}" SelectionChanged="Permission_SelectionChanged"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                        <Separator Margin="0,24"/>
                        <TextBlock Text="Logs" FontSize="20" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" Margin="0,12,0,0"><Button Content="Open logs" Click="OpenLogs_Click"/><Button Content="Clear logs" Margin="8,0,0,0" Click="ClearLogs_Click"/></StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
        <Border Grid.Row="2" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="24,12"><TextBlock Foreground="{DynamicResource MutedBrush}" Text="Native host: com.deskbridge.host  •  Production transport: Chrome Native Messaging  •  No local HTTP listener"/></Border>
    </Grid>
</Window>
