<Window x:Class="DeskBridge.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="DeskBridge" Width="1100" Height="760" MinWidth="860" MinHeight="600" WindowStartupLocation="CenterScreen">
  <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Background="#17212A" Padding="28,20"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="DeskBridge" Foreground="White" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="A deliberate local bridge for ChatGPT Web" Foreground="#BAC5CD" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Ellipse Width="10" Height="10" Fill="#55C59B" Margin="0,0,8,0"/><TextBlock Text="Control panel ready" Foreground="White" FontWeight="SemiBold"/></StackPanel></Grid></Border>
    <TabControl Grid.Row="1" Margin="24,20,24,12" Background="Transparent" BorderThickness="0">
      <TabItem Header="Workspace"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="6,22"><TextBlock Text="Current workspace" FontSize="13" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding Workspace}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,5,0,14"/><StackPanel Orientation="Horizontal"><Button Content="Choose workspace" Style="{StaticResource PrimaryButton}" Click="ChooseWorkspace_Click"/><Button Content="Open folder" Margin="8,0,0,0" IsEnabled="{Binding HasWorkspace}" Click="OpenWorkspace_Click"/></StackPanel><Separator Margin="0,28,0,22"/><TextBlock Text="How actions run" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="ChatGPT action blocks never run automatically. The native host validates the action, permission, workspace boundary, and action-specific arguments before execution." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" MaxWidth="720" HorizontalAlignment="Left" Margin="0,8,0,0"/></StackPanel></ScrollViewer></TabItem>
      <TabItem Header="Activity"><Grid Margin="6,18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,12"><TextBlock Text="Recent activity" FontSize="20" FontWeight="SemiBold" DockPanel.Dock="Left"/><Button Content="Refresh" HorizontalAlignment="Right" Click="Refresh_Click"/></DockPanel><ListView Grid.Row="1" ItemsSource="{Binding Activities}" BorderBrush="{StaticResource LineBrush}"><ListView.View><GridView><GridViewColumn Header="Time" Width="170" DisplayMemberBinding="{Binding Timestamp}"/><GridViewColumn Header="Action" Width="160" DisplayMemberBinding="{Binding Action}"/><GridViewColumn Header="Target" Width="430" DisplayMemberBinding="{Binding Target}"/><GridViewColumn Header="Result" Width="130" DisplayMemberBinding="{Binding Result}"/><GridViewColumn Header="ms" Width="70" DisplayMemberBinding="{Binding DurationMs}"/></GridView></ListView.View></ListView></Grid></TabItem>
      <TabItem Header="Assets"><Grid Margin="6,18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Margin="0,0,0,12"><TextBlock Text="Workspace assets" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Images found below folders named assets. DeskBridge does not edit them here." Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/></StackPanel><ListView Grid.Row="1" ItemsSource="{Binding Assets}" BorderBrush="{StaticResource LineBrush}"><ListView.View><GridView><GridViewColumn Header="File" Width="250" DisplayMemberBinding="{Binding Name}"/><GridViewColumn Header="Dimensions" Width="150" DisplayMemberBinding="{Binding Dimensions}"/><GridViewColumn Header="Size" Width="100" DisplayMemberBinding="{Binding Size}"/><GridViewColumn Header="Path" Width="500" DisplayMemberBinding="{Binding Path}"/></GridView></ListView.View></ListView></Grid></TabItem>
      <TabItem Header="Settings"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="6,20"><TextBlock Text="Permissions" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Ask is recommended for actions with side effects. There is no allow-everything setting." Foreground="{StaticResource MutedBrush}" Margin="0,5,0,15"/><ItemsControl ItemsSource="{Binding Permissions}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Label}" FontWeight="SemiBold"/><TextBlock Text="{Binding Description}" Foreground="{StaticResource MutedBrush}" Margin="0,3,20,0" TextWrapping="Wrap"/></StackPanel><ComboBox Grid.Column="1" ItemsSource="{Binding DataContext.Policies, RelativeSource={RelativeSource AncestorType=Window}}" SelectedItem="{Binding Policy, Mode=TwoWay}" SelectionChanged="Permission_SelectionChanged"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><Separator Margin="0,24"/><TextBlock Text="Logs" FontSize="20" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" Margin="0,12,0,0"><Button Content="Open logs" Click="OpenLogs_Click"/><Button Content="Clear logs" Margin="8,0,0,0" Click="ClearLogs_Click"/></StackPanel></StackPanel></ScrollViewer></TabItem>
    </TabControl>
    <Border Grid.Row="2" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="24,12"><TextBlock Foreground="{StaticResource MutedBrush}" Text="Native host: com.deskbridge.host  •  Production transport: Chrome Native Messaging  •  No local HTTP listener"/></Border>
  </Grid>
</Window>
