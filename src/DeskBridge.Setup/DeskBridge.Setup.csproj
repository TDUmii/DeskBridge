<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <UseWPF>true</UseWPF>
    <Version>1.4.1</Version>
    <AssemblyVersion>1.4.1.0</AssemblyVersion>
    <FileVersion>1.4.1.0</FileVersion>
    <ApplicationIcon>..\DeskBridge.App\Assets\app-icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup Condition="'$(InstallerPayload)' != ''">
    <EmbeddedResource Include="$(InstallerPayload)" LogicalName="DeskBridge.Setup.Payload.zip" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="..\DeskBridge.App\Assets\app-icon.png" Link="Assets\app-icon.png" />
  </ItemGroup>

</Project>
