<Window x:Class="DeskBridge.Setup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Install DeskBridge"
        Width="780" Height="600"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#0B1119"
        Foreground="#F4F8FC"
        FontFamily="Segoe UI"
        Icon="pack://application:,,,/Assets/app-icon.png">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#3E6A92" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="24,13" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonChrome" Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#315574" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="#839DB5" />
                                <Setter TargetName="ButtonChrome" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#142033"/><Setter Property="Background" Value="#E8EEF4"/><Setter Property="BorderBrush" Value="#60758A"/><Setter Property="Padding" Value="10,6"/><Setter Property="MinWidth" Value="112"/>
        </Style>
    </Window.Resources>

    <Grid Margin="34">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Width="58" Height="58" CornerRadius="14" Background="#111B27" Margin="0,0,16,0">
                <Image Source="pack://application:,,,/Assets/app-icon.png" Width="42" Height="42" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="DeskBridge" FontSize="27" FontWeight="SemiBold" />
                <TextBlock x:Name="Subtitle" Text="Verified ChatGPT Web file agent" Foreground="#AFC1D1" FontSize="13" Margin="0,4,0,0" />
            </StackPanel>
            <ComboBox x:Name="LanguagePicker" Grid.Column="2" VerticalAlignment="Center" Margin="0,0,10,0" SelectionChanged="LanguagePicker_SelectionChanged">
                <ComboBoxItem Content="English" IsSelected="True"/><ComboBoxItem Content="Tiếng Việt"/>
            </ComboBox>
            <Border Grid.Column="3" Background="#1D3833" CornerRadius="16" Padding="13,7" VerticalAlignment="Center">
                <TextBlock Text="Version 1.4.0" Foreground="#8FB7AC" FontWeight="SemiBold" />
            </Border>
        </Grid>

        <Grid Grid.Row="1" Margin="0,32,0,28">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.3*" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock x:Name="Heading" Text="One install. Everything in its place." FontSize="31" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock x:Name="Description"
                           Text="Installs the Windows app, local verifier, Chrome native connection, shortcuts, and extension files for this account. No API key or administrator access required."
                           Foreground="#B7C9D9" FontSize="15" LineHeight="23" TextWrapping="Wrap" Margin="0,14,0,0" />

                <StackPanel x:Name="FeatureList" Margin="0,25,0,0">
                    <TextBlock x:Name="FeatureApp" Text="App and local verifier" FontSize="15" Margin="0,0,0,12" />
                    <TextBlock x:Name="FeatureNative" Text="Protected Chrome Native Messaging" FontSize="15" Margin="0,0,0,12" />
                    <TextBlock x:Name="FeatureShortcuts" Text="Start menu and desktop shortcuts" FontSize="15" Margin="0,0,0,12" />
                    <TextBlock x:Name="FeatureExtension" Text="Extension folder prepared and copied" FontSize="15" />
                </StackPanel>

                <StackPanel x:Name="ProgressPanel" Visibility="Collapsed" Margin="0,25,0,0">
                    <TextBlock x:Name="ProgressText" Text="Preparing..." Foreground="#C7D9E8" FontSize="14" Margin="0,0,0,10" AutomationProperties.LiveSetting="Polite" />
                    <ProgressBar x:Name="InstallProgressBar" Height="8" Minimum="0" Maximum="100" Value="0" Foreground="#607F9B" Background="#182432" BorderThickness="0" AutomationProperties.Name="Installation progress" />
                </StackPanel>
            </StackPanel>

            <Border Grid.Column="2" Background="#111B27" CornerRadius="14" Padding="22">
                <StackPanel>
                    <TextBlock x:Name="PrivacyLabel" Text="Privacy boundary" Foreground="#8BA8C2" FontSize="14" FontWeight="SemiBold" />
                    <TextBlock x:Name="PrivacyTitle" Text="ChatGPT Web only" FontSize="20" FontWeight="SemiBold" Margin="0,12,0,0" />
                    <TextBlock x:Name="PrivacyDescription" Text="No Codex, API key, cookies, or browser tokens. Create-new sends no workspace files or local paths."
                               Foreground="#ADC1D3" FontSize="13" LineHeight="20" TextWrapping="Wrap" Margin="0,10,0,0" />
                    <Separator Background="#2A3A4C" Margin="0,20" />
                    <TextBlock x:Name="ChromeNotice" Text="Chrome protects extension installation. After this installer finishes, Chrome opens the one required confirmation step. The extension path is already copied."
                               Foreground="#D8B879" FontSize="13" LineHeight="20" TextWrapping="Wrap" />
                    <TextBlock x:Name="SigningNotice" Text="Until this installer is code-signed, Windows may also show an Unknown publisher or SmartScreen confirmation."
                               Foreground="#9FB3C5" FontSize="12" LineHeight="18" TextWrapping="Wrap" Margin="0,14,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="FooterText" Text="Installs to your local Windows profile" Foreground="#7890A5" VerticalAlignment="Center" />
            <Button x:Name="InstallButton" Grid.Column="1" Content="Install DeskBridge" MinWidth="190" IsDefault="True" Click="InstallButton_Click" />
        </Grid>
    </Grid>
</Window>
